#!/bin/bash
# cgw — switch Codex Web GPT between ChatGPT accounts in one command.
#
# Per account it keeps: ChatGPT browser login (partition snapshot), tunnel id, runtime key.
#   cgw adopt NAME                          register the account that is set up right now
#   cgw add NAME TUNNEL_ID KEY_FILE         register another account (key is copied, 0600)
#   cgw clip tunnel NAME                    take the tunnel id from the clipboard (user pressed copy)
#   cgw clip key NAME                       take the runtime key from the clipboard, verify, store, clear clipboard
#   cgw use NAME                            switch to NAME (DRY=1 cgw use NAME to preview)
#   cgw list | status | remove NAME | version
set -uo pipefail

H="$HOME/.codex-chatgpt-web"
ACC="$H/accounts"
APP="Codex Web GPT"
UD="$HOME/Library/Application Support/Codex Web GPT"
PART="$UD/Partitions/codex-web-gpt-chatgpt"
PORT=17841
CGW_VERSION="0.2.0"
TESTED_VERSION="6.1.5"   # codex-chatgpt-web release cgw was last verified against

die() { echo "cgw: $*" >&2; exit 1; }
run() { if [ "${DRY:-}" = 1 ]; then echo "[dry-run] $*"; else "$@"; fi; }

V=$(/bin/ls -d "$H"/versions/*/ 2>/dev/null | sort -V | tail -1); V=${V%/}
[ -n "$V" ] || die "no codex-chatgpt-web version found in $H/versions"
LAUNCHER_VERSION=${V##*/}; LAUNCHER_VERSION=${LAUNCHER_VERSION%%-*}
warn_version() {
  [ "$LAUNCHER_VERSION" = "$TESTED_VERSION" ] || echo "cgw: warning: codex-chatgpt-web $LAUNCHER_VERSION is newer/older than the tested $TESTED_VERSION; flags, file layout or launcher behavior may differ (see README > Compatibility). Continuing." >&2
}
cgw_cli() { "$V/runtime/bun" "$V/app/cli.js" "$@"; }

current() { cat "$ACC/.current" 2>/dev/null || true; }
env_get() { sed -n "s/^$2=//p" "$ACC/$1/account.env" | head -1; }
need_acc() { [ -f "$ACC/$1/account.env" ] || die "unknown account '$1' (see: cgw list)"; }

quit_launcher() {
  run osascript -e "tell application \"$APP\" to quit" >/dev/null 2>&1 || true
  [ "${DRY:-}" = 1 ] && return
  for _ in $(seq 1 30); do pgrep -x "$APP" >/dev/null || break; sleep 1; done
  pgrep -x "$APP" >/dev/null && die "$APP did not quit"
  sleep 2
  pkill -f "$H/bin/tunnel-client run" 2>/dev/null || true
  sleep 1
}

start_launcher() {
  run open -a "$APP"
  [ "${DRY:-}" = 1 ] && return
  for _ in $(seq 1 60); do
    [ -f "$H/runtime/launcher-browser.json" ] && lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1 && return
    sleep 1
  done
  die "launcher did not come up"
}

free_port() { # setup binds the proxy port itself; the launcher's own serve must step aside
  [ "${DRY:-}" = 1 ] && { echo "[dry-run] kill listener on :$PORT"; return; }
  local p; p=$(lsof -nP -iTCP:$PORT -sTCP:LISTEN -t 2>/dev/null || true)
  [ -n "$p" ] && echo "$p" | xargs kill
  for _ in 1 2 3 4 5 6 7 8; do lsof -nP -iTCP:$PORT -sTCP:LISTEN >/dev/null 2>&1 || return; sleep 1; done
  die "port $PORT still busy"
}

cmd_adopt() {
  local n=${1:-}; [ -n "$n" ] || die "usage: cgw adopt NAME"
  local tid; tid=$(python3 -c "import json;print(json.load(open('$H/config.json'))['tunnel']['tunnelId'])") || die "no tunnel in config.json"
  mkdir -p "$ACC/$n"; chmod 700 "$ACC" "$ACC/$n"
  install -m 600 "$H/secrets/tunnel-runtime-automatic.key" "$ACC/$n/runtime.key"
  printf 'TUNNEL_ID=%s\n' "$tid" > "$ACC/$n/account.env"
  echo "$n" > "$ACC/.current"
  echo "adopted '$n' ($tid) as the current account"
}

cmd_add() {
  local n=${1:-} tid=${2:-} kf=${3:-}
  if [ -z "$n" ] || [ -z "$tid" ] || [ ! -f "$kf" ]; then die "usage: cgw add NAME TUNNEL_ID KEY_FILE"; fi
  local code; code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $(cat "$kf")" "https://api.openai.com/v1/tunnels/$tid")
  [ "$code" = 200 ] || die "key cannot read that tunnel (HTTP $code) — check org/workspace and Tunnels Read+Use"
  local verb=added; [ -f "$ACC/$n/account.env" ] && verb=updated
  mkdir -p "$ACC/$n"; chmod 700 "$ACC" "$ACC/$n"
  install -m 600 "$kf" "$ACC/$n/runtime.key"
  printf 'TUNNEL_ID=%s\n' "$tid" > "$ACC/$n/account.env"
  echo "$verb '$n'. Apply with: cgw use $n   (a new account opens ChatGPT login first)"
}

cmd_clip() {
  local what=${1:-} n=${2:-}; [ -n "$n" ] || die "usage: cgw clip tunnel|key NAME"
  local v; v=$(pbpaste | tr -d '[:space:]')
  case "$what" in
    tunnel)
      [[ "$v" =~ ^tunnel_[0-9a-f]{32}$ ]] || die "clipboard does not hold a tunnel id (expected tunnel_ + 32 hex). Press the copy icon next to the tunnel id and retry"
      local verb=added; [ -f "$ACC/$n/account.env" ] && verb=updated
      mkdir -p "$ACC/$n"; chmod 700 "$ACC" "$ACC/$n"
      printf 'TUNNEL_ID=%s\n' "$v" > "$ACC/$n/account.env"
      echo "$verb '$n' tunnel: $v" ;;
    key)
      need_acc "$n"
      if [ "${#v}" -lt 20 ] || [[ "$v" == tunnel_* ]]; then die "clipboard does not look like a runtime key; copy it again right after creating it"; fi
      local tid code tmp; tid=$(env_get "$n" TUNNEL_ID)
      tmp=$(mktemp); chmod 600 "$tmp"; printf '%s' "$v" > "$tmp"
      code=$(curl -s -o /dev/null -w '%{http_code}' -H "Authorization: Bearer $v" "https://api.openai.com/v1/tunnels/$tid")
      if [ "$code" != 200 ]; then rm -f "$tmp"; pbcopy < /dev/null; die "key cannot read tunnel $tid (HTTP $code): create it in the same org/workspace as the tunnel with Tunnels Read+Use. Clipboard cleared"; fi
      install -m 600 "$tmp" "$ACC/$n/runtime.key"; rm -f "$tmp"; pbcopy < /dev/null
      echo "key for '$n' verified (HTTP 200), stored 0600, clipboard cleared" ;;
    *) die "usage: cgw clip tunnel|key NAME" ;;
  esac
}

cmd_use() {
  local n=${1:-}; [ -n "$n" ] || die "usage: cgw use NAME"; need_acc "$n"
  warn_version
  local cur; cur=$(current)
  local tid; tid=$(env_get "$n" TUNNEL_ID)
  local login="" ack=""
  # Only set CGW_ACK=1 after the user has explicitly accepted setup's "unofficial software" notice.
  [ "${CGW_ACK:-}" = 1 ] && ack="--acknowledge-unofficial"

  echo "==> quitting launcher"; quit_launcher

  if [ "$cur" != "$n" ]; then
    if [ -n "$cur" ] && [ -d "$PART" ]; then
      echo "==> saving ChatGPT login of '$cur'"
      run rm -rf "$ACC/$cur/partition.old"
      [ -d "$ACC/$cur/partition" ] && run mv "$ACC/$cur/partition" "$ACC/$cur/partition.old"
      run mv "$PART" "$ACC/$cur/partition"
      run rm -rf "$ACC/$cur/partition.old"
    elif [ -d "$PART" ]; then
      die "a ChatGPT login exists but no current account is registered — run: cgw adopt NAME first"
    fi
    if [ -d "$ACC/$n/partition" ]; then
      echo "==> restoring ChatGPT login of '$n'"
      run mv "$ACC/$n/partition" "$PART"
    else
      echo "==> no saved login for '$n' — a ChatGPT sign-in will be requested"; login="--login"
    fi
  fi

  echo "==> starting launcher"; start_launcher
  free_port
  echo "==> configuring tunnel for '$n'"
  if [ "${DRY:-}" = 1 ]; then
    echo "[dry-run] cgw setup --full $login $ack --refresh-account-capabilities --tunnel-id $tid --runtime-key-file $ACC/$n/runtime.key"
  else
    cgw_cli setup --full $login $ack --refresh-account-capabilities --tunnel-id "$tid" --runtime-key-file "$ACC/$n/runtime.key" || die "setup failed (launcher is open; fix and re-run: cgw use $n)"
  fi
  echo "==> restarting launcher so the tunnel profile is regenerated"
  quit_launcher; start_launcher
  [ "${DRY:-}" = 1 ] || echo "$n" > "$ACC/.current"
  sleep 5
  echo "==> doctor"; [ "${DRY:-}" = 1 ] || cgw_cli doctor 2>&1 | tail -14
  cat <<EOF

Done: active account = $n
Manual steps ChatGPT does not allow automating (once per account):
  1. https://chatgpt.com/#settings/Plugins -> attach this tunnel to connector "Codex Native2"
  2. Restart the Codex app if the model list looks stale
EOF
}

cmd_list() {
  local cur; cur=$(current)
  [ -d "$ACC" ] || { echo "no accounts yet — run: cgw adopt NAME"; return; }
  for d in "$ACC"/*/; do
    n=$(basename "$d"); [ -f "$d/account.env" ] || continue
    mark=" "; state=none
    if [ "$n" = "$cur" ]; then mark="*"; state=active; elif [ -d "$d/partition" ]; then state=saved; fi
    printf '%s %-16s %s  login:%s\n' "$mark" "$n" "$(env_get "$n" TUNNEL_ID)" "$state"
  done
}

cmd_status() { warn_version; echo "current: $(current || true)  |  codex-chatgpt-web $LAUNCHER_VERSION (tested: $TESTED_VERSION)"; cgw_cli doctor 2>&1 | tail -14; }

cmd_remove() {
  local n=${1:-}; need_acc "$n"; [ "$(current)" = "$n" ] && die "'$n' is active; switch first"
  rm -rf "${ACC:?}/$n"; echo "removed '$n' (saved login deleted)"
}

case "${1:-}" in
  adopt)  shift; cmd_adopt "$@" ;;
  add)    shift; cmd_add "$@" ;;
  clip)   shift; cmd_clip "$@" ;;
  use)    shift; cmd_use "$@" ;;
  version|--version|-v) echo "cgw $CGW_VERSION (tested with codex-chatgpt-web $TESTED_VERSION)" ;;
  list|ls) cmd_list ;;
  status) cmd_status ;;
  remove|rm) shift; cmd_remove "$@" ;;
  *) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
